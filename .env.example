# Painel Gerencial de Investimentos — SESI/MT
# Copie para .env no servidor on-premise e preencha com os valores reais.
# NUNCA versionar o .env real. Nenhuma destas variáveis pode usar prefixo VITE_.

NODE_ENV=
HOST=
PORT=

DATABASE_URL=

N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Origem oficial dos dados (consulta pública do Metabase em JSON).
# Vazio usa o link padrão do painel.
METABASE_JSON_URL=
# true apenas se o certificado do Metabase interno não for validado pelo servidor.
METABASE_TLS_INSECURE=

PAINEL_ADMIN_USER=
PAINEL_ADMIN_PASSWORD=
PAINEL_SESSION_SECRET=

# Exercício analisado (ex.: 2026)
PAINEL_ANO_PADRAO=
# Último mês encerrado (1-12). Ex.: 7 => JAN-JUL fechados, AGO parcial, SET-DEZ futuros.
PAINEL_MES_FECHADO=
